# Núclea Modeler — template de variáveis de ambiente
# Copie para .env e preencha. NUNCA commite .env (.gitignore bloqueia).

# ─── Databricks workspace (obrigatório para dev local) ──────────────────────

# Host do workspace (sem trailing slash)
DATABRICKS_HOST=https://fevm-stable-classic-pg4xe1.cloud.databricks.com

# Personal Access Token apenas para dev. Em produção, o app usa OAuth M2M
# automático via service principal — não precisa setar.
# Gere em: User Settings → Developer → Access tokens
DATABRICKS_TOKEN=dapi_XXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── Núclea app config ──────────────────────────────────────────────────────

# Unity Catalog onde o app armazena estado (Delta tables)
NUCLEA_CATALOG=stable_classic_pg4xe1_catalog
NUCLEA_SCHEMA=data_catalog_app

# SQL Warehouse para execução das queries Delta
NUCLEA_WAREHOUSE_ID=b8e52268d9828bdd
DATABRICKS_SQL_WAREHOUSE_ID=b8e52268d9828bdd

# Secret scope para credenciais de conexões (ODBC/REST)
NUCLEA_SECRETS_SCOPE=nuclea-modeler

# ─── Migrations ─────────────────────────────────────────────────────────────

# Auto-aplicar databricks/sql/*.sql no boot do app (default: true)
# Setar false em envs onde DDL é gerenciado por outro processo
NUCLEA_MIGRATIONS_AUTO_APPLY=true

# Override do path de migrations (default: detecta automaticamente)
# NUCLEA_MIGRATIONS_DIR=/custom/path/to/sql

# ─── Logging ────────────────────────────────────────────────────────────────

# Formato dos logs: false (texto humano) ou true (single-line JSON pra log aggregators)
NUCLEA_LOG_JSON=false

# Nível: DEBUG / INFO / WARNING / ERROR
NUCLEA_LOG_LEVEL=INFO

# ─── CORS (opt-in) ──────────────────────────────────────────────────────────

# CSV de origens permitidas pelo CORS. Vazio = same-origin only (default seguro).
# Setar quando precisar separar frontend/backend em hosts diferentes (mobile, B2B).
# NUCLEA_CORS_ALLOW_ORIGINS=https://mobile.nuclea,https://partner.nuclea

# ─── Feature flags (opt-in, default todas false) ────────────────────────────

# Vide src/nuclea_modeler/backend/core/features.py KNOWN_FLAGS para a lista completa
# NUCLEA_FEATURE_DER_MINIMAP=true
# NUCLEA_FEATURE_DER_AUTO_LAYOUT_V2=true
# NUCLEA_FEATURE_EMBARCADERO_V2=true
# NUCLEA_FEATURE_DDL_IMPORT_DRY_RUN=true
# NUCLEA_FEATURE_VERSIONS_SIGNED=true
# NUCLEA_FEATURE_SYNC_COLUMN_LINEAGE=true
# NUCLEA_FEATURE_GLOBAL_SEARCH_V2=true

# ─── Frontend dev (Vite) ────────────────────────────────────────────────────

# Vite roda em 5173 por default. Proxy /api → http://localhost:8000.
# Sem variáveis necessárias aqui.
