# EditorConfig — consistência entre IDEs (VS Code, IntelliJ, Sublime, vim).
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = space

# Python: PEP 8 — 4 spaces
[*.py]
indent_size = 4
max_line_length = 100

# TypeScript / JavaScript / JSON: 2 spaces (Prettier default)
[*.{ts,tsx,js,jsx,json,jsonc}]
indent_size = 2

# YAML é space-sensitive — 2 spaces estritos
[*.{yml,yaml}]
indent_size = 2

# Markdown: preserve trailing whitespace (significa hard line break)
[*.md]
indent_size = 2
trim_trailing_whitespace = false

# SQL: 4 spaces, alinhado com nosso style de migrations
[*.sql]
indent_size = 4

# TOML: 4 spaces (PEP 518 convention)
[*.toml]
indent_size = 4

# Makefile: tabs OBRIGATÓRIO (sintaxe make)
[Makefile]
indent_style = tab

# Shell scripts: 2 spaces (Google Shell Style Guide)
[*.{sh,bash}]
indent_size = 2
