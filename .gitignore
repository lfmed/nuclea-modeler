# Python-generated files
__pycache__/
*.py[oc]
*$py.class
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
venv/

# Test / cache
.pytest_cache/
.mypy_cache/
.ruff_cache/
.basedpyright/
htmlcov/
.coverage
coverage.xml

# Version / metadata — written by hand for direct-source deploy (no apx build)
# (kept tracked; do NOT ignore)

# JS-related
node_modules/
.tanstack/
*.tsbuildinfo
.vite/

# Env / secrets
.env
.env.local
.env.*
# Exception: example template é commitable (sem secrets reais)
!.env.example

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# DABs
.databricks/

# apx
.apx/

# UI build output — o bundle do Vite AGORA é versionado (workflow build-dist.yml)
# para o deploy do cliente funcionar sem npm. databricks sync respeita o
# .gitignore, então os assets NÃO podem ser ignorados. Só sourcemaps ficam fora.
src/nuclea_modeler/__dist__/*.map
.build/

# Logs
*.log
logs/

# Claude Code / agent state
.claude/scheduled_tasks.lock
.claude/settings.local.json

# Modelos de cliente — não comitar exports brutos
*.DM1
*.dm1
*.erx

# Prompt Registry — histórico de prompts do autor, mantido só local
docs/prompts/
