              {"name": "status", "expression": "`status`"},
              {"name": "qtd", "expression": "`qtd`"}
            ], "disaggregated": true}}],
            "spec": {"version": 3, "widgetType": "pie", "encodings": {
              "angle": {"fieldName": "qtd", "scale": {"type": "quantitative"}, "displayName": "Qtd"},
              "color": {"fieldName": "status", "scale": {"type": "categorical"}, "displayName": "Status"}
            }}
          },
