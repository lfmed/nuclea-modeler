          "position": {"x": 0, "y": 7, "width": 6, "height": 5}
        },
        {
          "widget": {
            "name": "w_tickets_timeline",
            "queries": [{"name": "main_query", "query": {"datasetName": "ds_tickets_timeline", "fields": [
              {"name": "dia", "expression": "`dia`"},
