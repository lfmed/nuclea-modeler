            "queries": [{"name": "main_query", "query": {"datasetName": "ds_entities_by_system", "fields": [
              {"name": "system_name", "expression": "`system_name`"},
              {"name": "environment", "expression": "`environment`"},
              {"name": "entidades", "expression": "`entidades`"}
            ], "disaggregated": true}}],
            "spec": {"version": 3, "widgetType": "bar", "encodings": {
              "x": {"fieldName": "entidades", "scale": {"type": "quantitative"}},
              "y": {"fieldName": "system_name", "scale": {"type": "categorical"}, "displayName": "Sistema"},
              "color": {"fieldName": "environment", "scale": {"type": "categorical"}, "displayName": "Env"}
